@page
@model Bd2.Server.Pages.Admin.PlayersModel
@{
    ViewData["Title"] = "玩家管理";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">玩家列表</span>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="kw" value="@Model.Keyword" class="form-control form-control-sm" placeholder="搜索邮箱或 UserID" style="width:220px;" />
            <button type="submit" class="btn btn-sm btn-outline-primary">搜索</button>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>UID</th>
                    <th>UserID</th>
                    <th>账户邮箱</th>
                    <th>金币</th>
                    <th>付费钻</th>
                    <th>免费钻</th>
                    <th>经验</th>
                    <th>状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Players)
                {
                    <tr>
                        <td>@p.User.OwnerIndex</td>
                        <td class="text-truncate" style="max-width:180px;">@p.User.UserId</td>
                        <td class="text-truncate" style="max-width:240px;">@p.Email</td>
                        <td>@p.User.Gold.ToString("N0")</td>
                        <td>@p.User.Jewelry</td>
                        <td>@p.User.FreeJewelry</td>
                        <td>@p.User.Exp</td>
                        <td>
                            @if (p.User.BlockDate > 0)
                            {
                                <span class="badge bg-danger">封禁</span>
                            }
                            else
                            {
                                <span class="badge bg-success">正常</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/PlayerDetail?id=@p.User.OwnerIndex" class="btn btn-sm btn-outline-primary">详情</a>
                            <a href="/Admin/Quests?uid=@p.User.UserId" class="btn btn-sm btn-outline-info">任务</a>
                            <a href="/Admin/Mail?uid=@p.User.UserId" class="btn btn-sm btn-outline-warning">发邮件</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-end">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="?page=@i&kw=@Model.Keyword">@i</a>
                </li>
            }
        </ul>
    </nav>
}
