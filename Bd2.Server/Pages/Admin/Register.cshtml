@page
@model Bd2.Server.Pages.Admin.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "注册管理员";
    ViewData["NoLayout"] = true;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>注册管理员 - BD2 Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f0f2f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .register-card { width: 400px; background: #fff; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.1); padding: 40px; }
        .register-card h3 { text-align: center; color: #e94560; font-weight: 700; margin-bottom: 8px; }
        .register-card .subtitle { text-align: center; color: #999; font-size: 14px; margin-bottom: 30px; }
    </style>
</head>
<body>
    <div class="register-card">
        <h3>BD2 Admin</h3>
        <p class="subtitle">首次使用，请创建管理员账户</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">用户名</label>
                <input asp-for="Input.UserName" class="form-control" placeholder="admin" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">密码</label>
                <input asp-for="Input.Password" class="form-control" type="password" placeholder="至少6位" />
            </div>
            <div class="mb-3">
                <label class="form-label">确认密码</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">创建管理员</button>
        </form>
    </div>
</body>
</html>
