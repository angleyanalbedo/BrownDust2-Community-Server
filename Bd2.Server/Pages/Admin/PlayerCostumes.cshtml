@page
@model Bd2.Server.Pages.Admin.PlayerCostumesModel
@{ ViewData["Title"] = "玩家服装管理"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h4>玩家服装管理</h4><a class="btn btn-outline-secondary" href="/Admin/PlayerDetail?id=@Model.Uid">返回玩家详情</a></div>
<div class="card mb-3"><div class="card-header">添加普通服装</div><div class="card-body"><form id="addCostumeForm" method="post" asp-page-handler="Add" class="row g-2"><input type="hidden" name="Uid" value="@Model.Uid" /><div class="col-md-5"><label class="form-label">服装</label><input id="costumeSearch" class="form-control" list="costumeList" placeholder="搜索角色名、服装名或 ID" autocomplete="off" required /><datalist id="costumeList">@foreach(var x in Model.CostumeOptions){<option value="@x.Id - @x.Name"></option>}</datalist><input name="CostumeId" id="costumeId" type="hidden" /><div class="form-text">格式：服装 ID - 角色名 / 服装名</div></div><div class="col-md-3"><label class="form-label">等级</label><input name="Level" type="number" min="1" value="1" class="form-control" /></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary">添加服装</button></div></form></div></div>
@if (Model.BossCostumeOptions.Count > 0)
{
    <div class="card mb-3 border-warning"><div class="card-header">Boss / 怪物外观（仅记录，不可添加到玩家）</div><div class="card-body small">@foreach (var x in Model.BossCostumeOptions){<span class="badge text-bg-secondary me-1 mb-1">@x.Name (@x.Id)</span>}</div></div>
}
<div class="card"><div class="card-header">已拥有服装 (@Model.Costumes.Count)</div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>服装 ID</th><th>名称</th><th>等级</th><th>操作</th></tr></thead><tbody>@foreach (var c in Model.Costumes){<tr><td>@c.Id</td><td>@Model.Name(c.Id)</td><td><form method="post" asp-page-handler="Update" class="d-flex gap-1"><input type="hidden" name="Uid" value="@Model.Uid" /><input type="hidden" name="InvenIndex" value="@c.InvenIndex" /><input name="Level" value="@c.Level" type="number" min="1" class="form-control form-control-sm" style="width:70px" /><button class="btn btn-sm btn-outline-primary">保存</button></form></td><td><form method="post" asp-page-handler="Delete" onsubmit="return confirm('确认删除此服装？')"><input type="hidden" name="Uid" value="@Model.Uid" /><input type="hidden" name="InvenIndex" value="@c.InvenIndex" /><button class="btn btn-sm btn-outline-danger">删除</button></form></td></tr>}</tbody></table></div></div>
<div class="card mt-3"><div class="card-header">已解锁甄选/特别皮肤 (@Model.PrestigeSkins.Count)</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>角色/服装</th><th>服装 ID</th><th>设计 ID</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach(var p in Model.PrestigeSkins){<tr><td>@Model.Name(p.CostumeId)</td><td>@p.CostumeId</td><td>@p.CostumeDesignId</td><td>@(p.IsSet == 1 ? "已设置" : "已解锁")</td><td><form method="post" asp-page-handler="UnsetPrestige" class="d-inline"><input type="hidden" name="Uid" value="@Model.Uid" /><input type="hidden" name="Index" value="@p.Index" /><button class="btn btn-sm btn-outline-warning">取消设置</button></form><form method="post" asp-page-handler="DeletePrestige" class="d-inline" onsubmit="return confirm('确认删除皮肤解锁记录？')"><input type="hidden" name="Uid" value="@Model.Uid" /><input type="hidden" name="Index" value="@p.Index" /><button class="btn btn-sm btn-outline-danger">删除</button></form></td></tr>}</tbody></table></div></div>
@foreach (var group in new[] { (Title: "甄选皮肤", Items: Model.PrestigeOptions), (Title: "特别皮肤", Items: Model.SpecialOptions) }) {<div class="card mt-3"><div class="card-header">@group.Title</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>角色 / 服装</th><th>设计 ID</th><th>操作</th></tr></thead><tbody>@foreach(var x in group.Items){var owned = Model.PrestigeSkins.FirstOrDefault(p => p.CostumeDesignId == x.DesignId && p.CostumeId == x.CostumeId);<tr><td>@x.Name</td><td>@x.DesignId</td><td>@if(owned == null){<form method="post" asp-page-handler="Prestige" class="d-inline"><input type="hidden" name="Uid" value="@Model.Uid" /><input type="hidden" name="CostumeId" value="@x.CostumeId" /><input type="hidden" name="CostumeDesignId" value="@x.DesignId" /><input type="hidden" name="IsSet" value="true" /><button class="btn btn-sm btn-outline-primary">解锁并设置</button></form>}else{<span class="text-success me-2">@(owned.IsSet == 1 ? "已设置" : "已解锁")</span>}</td></tr>}</tbody></table></div></div>}
<script>
(() => {
    const search = document.getElementById('costumeSearch');
    const id = document.getElementById('costumeId');
    const form = document.getElementById('addCostumeForm');
    const sync = () => { const match = search.value.match(/^\s*(\d+)\s*-\s*/); id.value = match ? match[1] : ''; };
    search.addEventListener('input', sync);
    search.addEventListener('change', sync);
    form.addEventListener('submit', event => { sync(); if (!id.value) { event.preventDefault(); search.setCustomValidity('请从下拉列表中选择有效服装'); search.reportValidity(); } else search.setCustomValidity(''); });
})();
</script>
