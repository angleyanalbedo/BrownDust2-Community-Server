@page
@model Bd2.Server.Pages.Admin.QuestsModel
@using Bd2.Server.Common.Managers
@{
    ViewData["Title"] = "任务管理";
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">任务管理</span>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="uid" value="@Model.Uid" class="form-control form-control-sm" placeholder="玩家 UserID" style="width:220px;" />
            <button type="submit" class="btn btn-sm btn-outline-primary">查询</button>
        </form>
    </div>
</div>
<a href="/Admin/Players" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> 返回玩家列表</a>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") py-2">@Model.Message</div>
}

@if (Model.QuestList.Any())
{
    <div class="row g-3">
        @foreach (var pack in Model.PackQuests)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">@PackManager.GetName(pack.PackId) <span class="text-muted">(Pack @pack.PackId)</span></span>
                        @if (pack.IsComplete)
                        {
                            <span class="badge bg-success">已完成</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">进行中</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="mb-2"><strong>当前任务:</strong> @pack.Definitions.FirstOrDefault(x => x.Id == pack.CurrentQuestId)?.Name <span class="text-muted">(ID: @pack.CurrentQuestId)</span></div>
                        <div class="mb-2">
                            <strong>已过任务:</strong>
                            @if (pack.ClearedQuestIds.Any())
                            {
                                @string.Join(", ", pack.ClearedQuestIds)
                            }
                            else
                            {
                                <span class="text-muted">无</span>
                            }
                        </div>
                        <div class="mb-2"><strong>任务链:</strong> @pack.QuestChain</div>

                        @if (pack.Definitions.Any())
                        {
                            <hr />
                            <div class="mb-1"><strong>任务定义:</strong></div>
                            @foreach (var q in pack.Definitions)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small">
                                        Quest @q.Id
                                        @if (pack.ClearedQuestIds.Contains(q.Id))
                                        {
                                            <span class="badge bg-success ms-1">已过</span>
                                        }
                                        else if (q.Id == pack.CurrentQuestId)
                                        {
                                            <span class="badge bg-warning ms-1">当前</span>
                                        }
                                    </span>
                                    @if (!pack.ClearedQuestIds.Contains(q.Id))
                                    {
                                        <form method="post" asp-page-handler="CompleteSpecificQuest" class="d-inline">
                                            <input type="hidden" name="uid" value="@Model.Uid" />
                                            <input type="hidden" name="packId" value="@pack.PackId" />
                                            <input type="hidden" name="questId" value="@q.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">完成</button>
                                        </form>
                                    }
                                </div>
                            }
                        }
                    </div>
                    <div class="card-footer">
                        <form method="post" asp-page-handler="CompleteQuest" class="d-inline">
                            <input type="hidden" name="uid" value="@Model.Uid" />
                            <input type="hidden" name="packId" value="@pack.PackId" />
                            <button type="submit" class="btn btn-sm btn-outline-success"
                                    onclick="return confirm('确认将 Pack @pack.PackId 当前任务标记为完成？')">
                                完成当前任务
                            </button>
                        </form>
                        <form method="post" asp-page-handler="CompletePack" class="d-inline">
                            <input type="hidden" name="uid" value="@Model.Uid" />
                            <input type="hidden" name="packId" value="@pack.PackId" />
                            <button type="submit" class="btn btn-sm btn-success"
                                    onclick="return confirm('确认完成整个大任务 Pack @pack.PackId？')">
                                完成整个大任务
                            </button>
                        </form>
                        <form method="post" asp-page-handler="ResetPack" class="d-inline">
                            <input type="hidden" name="uid" value="@Model.Uid" />
                            <input type="hidden" name="packId" value="@pack.PackId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('确认重置 Pack @pack.PackId 所有进度？')">
                                重置
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.Uid))
{
    <div class="alert alert-info">该玩家暂无任务进度数据。</div>
}
